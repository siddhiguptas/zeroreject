# ZeroReject (PramaanFix) Configuration

# Core API
API_HOST=0.0.0.0
API_PORT=8001
ENVIRONMENT=production
LOG_LEVEL=INFO

# Standalone Legacy Government e-District Target Portal (Port 8090)
GOV_PORTAL_HOST=0.0.0.0
GOV_PORTAL_PORT=8090
GOV_PORTAL_BASE_URL=http://localhost:8090

# Database
# Default: SQLite with WAL mode (zero-config, high-reliability local execution, sovereign zero-leak)
DATABASE_URL=sqlite+aiosqlite:///./zeroreject.db

# Live External APIs
INDIA_POST_API_BASE=https://api.postalpincode.in/pincode
DATA_GOV_IN_API_KEY=

# Google Gemini Vision API (Optional - local OpenCV/Tesseract fallback ensures 100% deterministic local execution)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OCR & Vision Local Engine (auto-detected across Linux / macOS)
TESSERACT_CMD=/usr/bin/tesseract

# Playwright Browser Automation (Headless on server VM)
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_SLOW_MO_MS=150

# Web Application (Leave NEXT_PUBLIC_API_URL empty to use Next.js internal reverse-proxy on Port 3000, eliminating CORS/firewall issues)
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_GOV_PORTAL_URL=http://localhost:8090

