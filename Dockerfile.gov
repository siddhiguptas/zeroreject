FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    GOV_PORTAL_PORT=8090

WORKDIR /app

RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir fastapi uvicorn[standard] jinja2 python-multipart

COPY apps/gov_portal_target /app/apps/gov_portal_target

EXPOSE 8090

CMD ["python", "-m", "uvicorn", "apps.gov_portal_target.app:app", "--host", "0.0.0.0", "--port", "8090"]

